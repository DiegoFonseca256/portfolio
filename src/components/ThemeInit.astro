---
// Render first thing in <head>. Runs blocking, before first paint, so a saved
// theme never flashes the system one first. A failure to read storage leaves
// the system theme in place.
import { STORAGE_KEY } from './theme-storage';
---

<script is:inline define:vars={{ STORAGE_KEY }}>
  try {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
  } catch {
    // Storage unavailable: follow the system theme.
  }
</script>
