---
// The Experiência and education timeline, most recent first. A filled dot marks
// work and a hollow one education; screen readers get the same as text.
import { experiences } from '@/data/experience';
import { formatMonth } from '@/lib/dates';
import type { Locale } from '@/i18n/locales';
import { t } from '@/i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale);
const dot = { work: 'border-link bg-link', education: 'border-muted-foreground bg-background' } as const;
---

<div>
  <p class="flex flex-wrap gap-x-6 gap-y-1 text-sm text-muted-foreground" aria-hidden="true">
    <span class="flex items-center gap-2"><span class:list={['size-3 rounded-full border-2', dot.work]}></span>{tr('experience.work')}</span>
    <span class="flex items-center gap-2"><span class:list={['size-3 rounded-full border-2', dot.education]}></span>{tr('experience.education')}</span>
  </p>

  <ol class="mt-8 border-l border-border">
    {
      experiences.map((entry) => (
        <li class="relative pb-10 pl-6 last:pb-0 md:grid md:grid-cols-[10rem_minmax(0,1fr)] md:gap-8 md:pl-8">
          <span class:list={['absolute top-1.5 -left-[7px] size-3.5 rounded-full border-2', dot[entry.kind]]} aria-hidden="true" />
          <p class="text-sm text-muted-foreground tabular-nums">
            <time datetime={entry.start}>{formatMonth(entry.start, locale)}</time>
            {' – '}
            {entry.end ? <time datetime={entry.end}>{formatMonth(entry.end, locale)}</time> : tr('experience.present')}
          </p>
          <div class="mt-1 md:mt-0">
            <h3 class="font-semibold">
              <span class="sr-only">{tr(`experience.${entry.kind}`)}: </span>
              {entry.org[locale]}
            </h3>
            <p class="text-muted-foreground">{entry.role[locale]}</p>
            {entry.note && <p class="mt-2 text-sm">{entry.note[locale]}</p>}
            {entry.achievements[locale].length > 0 && (
              <ul class="mt-3 max-w-[65ch] list-disc space-y-1.5 pl-5 marker:text-muted-foreground">
                {entry.achievements[locale].map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</div>
