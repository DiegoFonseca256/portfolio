---
import { localizePath, type Locale } from '../i18n/locales';
import { t } from '../i18n/ui';
import { profile } from '../data/profile';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
// Self-hosted fonts: no third-party request, and they ship with the build.
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/instrument-sans/index.css';
import '@fontsource/fragment-mono/400.css';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const tr = t(locale);
const other: Locale = locale === 'en' ? 'pt' : 'en';
const switchHref = localizePath(Astro.url.pathname, other);
const homeHref = localizePath('/', locale);
---

<!doctype html>
<html lang={locale === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <ThemeInit />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <a class="skip visually-hidden" href="#main">{tr('nav.skip')}</a>
    <div class="shell">
      <header class="identity">
        <p class="name"><a href={homeHref}>{profile.name}</a></p>
        <p class="role">{tr('identity.role')}</p>
        <slot name="identity" />
        <nav class="controls" aria-label={tr('nav.label')}>
          <a
            href={switchHref}
            hreflang={other === 'pt' ? 'pt-BR' : 'en'}
            lang={other === 'pt' ? 'pt-BR' : 'en'}
            aria-label={tr('lang.switchLabel')}
            data-lang-switch
          >
            {tr('lang.switch')}
          </a>
          <ThemeToggle label={tr('theme.dark')} />
        </nav>
      </header>
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .skip {
    position: fixed;
    top: var(--space-xs);
    left: var(--space-xs);
    z-index: 10;
    padding: var(--space-2xs) var(--space-s);
    background: var(--color-text);
    color: var(--color-bg);
  }

  .shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-height: 100vh;
  }

  .identity {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: var(--space-l) var(--gutter);
    border-bottom: 1px solid var(--color-rule);
  }
  .name {
    margin: 0;
    font: 400 var(--text-name) / var(--leading-tight) var(--font-display);
    letter-spacing: -0.01em;
  }
  .name a {
    color: var(--color-text);
    text-decoration: none;
  }
  .role {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-m);
  }
  .controls > a {
    color: var(--color-text);
  }

  main {
    min-width: 0;
    max-width: var(--content-max);
    padding: var(--space-l) var(--gutter) var(--space-3xl);
  }
  main:focus {
    outline: none;
  }

  /* Wide screens: the identity column sticks beside the scrolling content. */
  @media (min-width: 900px) {
    .shell {
      grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
    }
    .identity {
      position: sticky;
      top: 0;
      align-self: start;
      height: 100vh;
      overflow-y: auto;
      padding-block: var(--space-xl);
      border-bottom: 0;
      border-right: 1px solid var(--color-rule);
    }
    .controls {
      margin-top: auto;
      padding-top: var(--space-m);
      border-top: 1px solid var(--color-rule);
    }
    main {
      padding-block: var(--space-xl) var(--space-3xl);
    }
  }
</style>
